{
  "expo": {
    "name": "点卯侠", "slug": "chaoxing-sign-tool", "scheme": "sign-tool", "version": "0.5.1", "icon": "./assets/icon.png",
    "orientation": "portrait", "userInterfaceStyle": "automatic", "newArchEnabled": true,
